# Consigue tu API key gratis en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_aqui

# Modelo de Groq a usar (Llama 3.3 70B es el recomendado por calidad/velocidad)
GROQ_MODEL=llama-3.3-70b-versatile

# Voz de edge-tts (español latino, masculina). Otras opciones abajo en tts.ts
EDGE_TTS_VOICE=es-MX-JorgeNeural

# Tono y velocidad de la voz (ajusta para sonar más juguetona)
TTS_PITCH=+20Hz
TTS_RATE=1.1

# Turso (base de datos para memoria persistente del robot). Gratis en https://turso.tech
TURSO_DATABASE_URL=tu_url_aqui
TURSO_AUTH_TOKEN=tu_token_aqui
