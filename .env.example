# ==========================================================================
#  Ivi - server backend
#  Copiar a ".env" con los valores reales (NUNCA subir .env al repo).
#
#  EN RENDER: estas mismas variables se cargan en el dashboard del servicio
#  Web (Settings -> Environment). Render inyecta PORT automáticamente,
#  así que PORT acá es solo para correr en local.
# ==========================================================================

# Consigue tu API key gratis en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_aqui

# Modelo principal de Groq. Medido: ~0.8s de respuesta y 150-216 tokens de
# salida. OJO: el límite de Groq son 200,000 tokens/día POR MODELO.
GROQ_MODEL=openai/gpt-oss-120b

# Modelo de respaldo: se usa solo si el principal no tiene cuota o falla.
# Como la cuota es por modelo, tener dos duplica la capacidad diaria gratis.
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Modelo para extraer datos personales (memoria). Es opcional: si no tiene
# cuota, la extracción se omite y el robot sigue funcionando.
GROQ_MODEL_EXTRACCION=openai/gpt-oss-20b

# Tope de tiempo del turno completo (ms). El ESP32 aborta el POST a los 65000ms:
# si el server se pasa, el dispositivo se queda sin audio. 45000 deja margen.
TURNO_DEADLINE_MS=45000

# Tope de tiempo del LLM dentro del turno (ms) y reintentos con backoff.
# Con cuota agotada, reintentar un 429 de "tokens per day" nunca funciona:
# el código lo detecta y pasa directo al modelo de respaldo sin gastar tokens.
GROQ_TIMEOUT_MS=8000
GROQ_BUDGET_MS=12000
GROQ_RETRIES=1

# NO definas GROQ_REASONING_EFFORT salvo que sepas que tu modelo lo acepta:
# solo admite low/medium/high y un valor inválido hace que Groq rechace el
# request con 400. Los modelos gpt-oss no lo necesitan para respuesta corta.

# Voz de Ivi (edge-tts, español de México, femenina). Tiene que coincidir con el
# default de src/tts.ts: si no, los MP3 pregrabados y el del firmware suenan
# con otra voz que las respuestas normales. Otras opciones abajo en tts.ts.
EDGE_TTS_VOICE=es-MX-DaliaNeural

# Tono y velocidad de la voz (ajusta para sonar más juguetona)
TTS_PITCH=+20Hz
TTS_RATE=1.1

# Tope de tiempo POR INTENTO de síntesis de audio (ms), con 1 reintento y
# backoff. Si se agotan los intentos se sirve el MP3 de emergencia para que
# Ivi no quede muda. El peor caso es ~16s y tiene que entrar en
# TURNO_DEADLINE_MS junto al LLM, o el device corta el POST y el turno se
# pierde entero.
TTS_TIMEOUT_MS=8000

# Turso (base de datos para memoria persistente del robot). Gratis en https://turso.tech
# Opcional en producción: si no existe, la memoria se desactiva pero el server sigue vivo.
TURSO_DATABASE_URL=tu_url_aqui
TURSO_AUTH_TOKEN=tu_token_aqui

# Zona horaria con la que Ivi responde "¿qué día es hoy?". OBLIGATORIA en
# Render: el server corre en UTC, así que sin esto da el día/hora equivocados.
# Valor por defecto: America/Mazatlan (UTC-7 fijo, sin horario de verano) = Tepic.
FECHA_TZ=America/Mazatlan

# Puerto del servidor. Render lo inyecta automáticamente (no lo definas ahí).
PORT=3000

# URL base del backend (la usa scripts/test-api.ts para pruebas).
SERVER_URL=http://localhost:3000

# ==========================================================================
#  FASE 2 — Portal de redes WiFi (Prisma + PostgreSQL)
# ==========================================================================

# Postgres (Neon o Supabase free tier). Connection string completo:
# postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://usuario:password@host:5432/ivi?sslmode=require

# Login del panel admin (único usuario, dueño de Ivi).
ADMIN_USER=ivi
ADMIN_PASSWORD=elige_un_password_fuerte
ADMIN_SECRET=cambia_este_secreto_largo

# Clave de cifrado AES-256-GCM para las contraseñas WiFi en la DB.
# Genérala con:  openssl rand -hex 32
WIFI_ENC_KEY=reemplaza_con_32_bytes_en_hex
# ==========================================================================
# Copiloto de OpenCode
#
# El plugin (en ~/.config/opencode/plugins/ivi-copilot.js) publica a qué está
# trabajando OpenCode y este server lo reinyecta como contexto en la voz.
#
# COPILOT_TOKEN debe ser EXACTAMENTE el mismo valor que IVI_TOKEN en
# ~/.config/opencode/ivi.env. Es lo único que autoriza a publicar estado.
# Sin COPILOT_TOKEN el endpoint responde 503 y el copiloto queda apagado.
COPILOT_TOKEN=tu_token_compartido_con_ivi_env

# Qué proyectos pueden reportar estado. Sin esta lista el endpoint responde
# 503 aunque el token sea válido: es una allowlist, no un default.
COPILOT_PROJECTS=mochi-server

# Cuánto sigue siendo confiable el estado. 3 horas aguanta una sesión de
# trabajo; con 30 min se perdía el contexto en un café. Pasado esto, Ivi
# prefiere decir "no tengo esa info" antes que hablar de algo viejo.
COPILOT_MAX_AGE_MIN=180

# Tope de peticiones del plugin por minuto, para que un plugin descontrolado
# no hunda el free tier.
COPILOT_RATE_MAX=60
COPILOT_RATE_MS=60000
