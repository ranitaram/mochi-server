{
  "name": "mochi-server",
  "version": "1.0.0",
  "description": "Servidor orquestador para el robot con cara animada: Groq (texto) + edge-tts (voz)",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "server": "ts-node src/server.ts",
    "build": "tsc && mkdir -p dist/public dist/assets && cp -r src/public dist/ && cp -r src/assets dist/",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "crear-device": "ts-node scripts/crear-device.ts",
    "test-api": "ts-node scripts/test-api.ts",
    "generar-muletillas": "ts-node scripts/generar-muletillas.ts",
    "generar-fallback-audio": "ts-node scripts/generar-fallback-audio.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "groq-sdk": "^1.5.0",
    "msedge-tts": "^2.0.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
